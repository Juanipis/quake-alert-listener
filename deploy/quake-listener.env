# /etc/default/quake-listener: settings for the systemd unit (see README for all options)
QUAKE_LAT=0.0
QUAKE_LON=0.0
QUAKE_NAME=Base Station
# QUAKE_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/quake_alert_local
# QUAKE_WEBHOOK_SECRET=change-me
# QUAKE_SOURCES=mcs,emsc,wolfx,usgs     # default; in Colombia add sgc: mcs,emsc,wolfx,usgs,sgc
# QUAKE_NOTICE_MMI=3.0
# QUAKE_ALERT_MMI=5.0
# QUAKE_SHAKE_UDP=8888
# QUAKE_HTTP_HOST=0.0.0.0       # only if Home Assistant runs on another machine
# QUAKE_ANDROID_SECRET=change-me   # required for POST /android from other machines (android_alert_listener.py)
# QUAKE_LOCALE=en_US              # announced by the Google MCS checkin (experimental source)
# QUAKE_TIMEZONE=UTC
